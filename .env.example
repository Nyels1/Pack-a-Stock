# ============================================
# PACK-A-STOCK API - CONFIGURACIÓN SEGURA
# ============================================

# Django Core Settings
# IMPORTANTE: Cambiar en producción - Generar con: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here-change-in-production-min-50-chars-random
DEBUG=False  # SIEMPRE False en producción | True solo en desarrollo

# IMPORTANTE: Lista separada por comas de dominios/IPs permitidos
# Desarrollo: localhost,127.0.0.1
# Producción: 198.71.54.179,yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Database PostgreSQL (DESARROLLO)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pack_a_stock_db
DB_NAME=pack_a_stock_db
DB_USER=postgres
DB_PASSWORD=postgres  # CAMBIAR en producción - mínimo 16 caracteres
DB_HOST=localhost
DB_PORT=5432

# Redis (Tareas asíncronas)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# AWS S3 Configuration (Opcional - para almacenar archivos media)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=pack-a-stock-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=
AWS_DEFAULT_ACL=public-read

# JWT Security Settings (MEJORADO)
# Access token: 30 minutos (recomendado para alta seguridad, antes 60)
JWT_ACCESS_TOKEN_LIFETIME=30
# Refresh token: 7 días (recomendado, antes 24 horas)
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS Settings (Frontend URLs)
# Desarrollo: http://localhost:3000,http://localhost:5173
# Producción: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# NOTAS DE SEGURIDAD IMPORTANTES
# ============================================
# 1. NUNCA subir este archivo a Git/GitHub
# 2. Usar contraseñas fuertes (mínimo 16 caracteres)
# 3. Cambiar SECRET_KEY en producción (50+ caracteres aleatorios)
# 4. Mantener DEBUG=False en producción
# 5. Configurar ALLOWED_HOSTS específico (no usar *)
# 6. Usar HTTPS en producción
# 7. Rotar credenciales periódicamente
# 8. En producción usar CORS solo con HTTPS
