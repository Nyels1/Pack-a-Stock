# ===========================================
# PACK-A-STOCK - BACKEND ENVIRONMENT VARIABLES
# ===========================================

# -----------------
# Django Core
# -----------------
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*.ngrok.io

# -----------------
# Database PostgreSQL
# -----------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pack_a_stock_db
DB_NAME=pack_a_stock_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# -----------------
# CORS (Frontend URLs)
# -----------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------
# JWT Settings
# -----------------
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# -----------------
# File Storage - Cloudflare R2 (🆓 GRATIS - Recomendado)
# -----------------
# CLOUDFLARE R2 CONFIGURADO - Copiar estas credenciales a tu .env
USE_S3=True
AWS_ACCESS_KEY_ID=46f09c0ff993c880a2376fddfc2af459
AWS_SECRET_ACCESS_KEY=571d49743dfb3259ed72b5e593f9b722438000294307aac3e34fb5d55b9d8bbb
AWS_STORAGE_BUCKET_NAME=pack-a-stock
AWS_S3_ENDPOINT_URL=https://c39a8b5dd9636c4194048a9ced08c16c.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=
AWS_DEFAULT_ACL=public-read

# ALTERNATIVAS DE PAGO:
# DigitalOcean Spaces ($5/mes): AWS_S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
# AWS S3 (variable): AWS_S3_REGION_NAME=us-east-1 (sin endpoint)

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=pack-a-stock-media
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_DEFAULT_ACL=public-read

# -----------------
# Redis / Celery (opcional - para tareas asíncronas)
# -----------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

